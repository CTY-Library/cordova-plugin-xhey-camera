<?xml version="1.0" encoding="utf-8"?>
<plugin id="cordova-plugin-xhey-camera" version="0.0.1" xmlns="http://apache.org/cordova/ns/plugins/1.0" xmlns:android="http://schemas.android.com/apk/res/android">
  <name>XheyCamera</name>
  <description>Cordova plugin wrapper for Xhey (今日水印) Camera SDK</description>
  <license>MIT</license>
  <preference name="APPID" />
  <preference name="SECRET_KEY" />

  <js-module src="www/xhey-camera.js" name="XheyCamera">
    <clobbers target="XheyCamera" />
  </js-module>

  <platform name="android">
    <!-- The AAR and assets are embedded under src/android/libs and src/android/assets -->
    <lib-file src="src/android/libs/xheycamerasdk-release.aar" target="app/libs/xheycamerasdk-release.aar" />
    <resource-file src="src/android/assets/XheyCameraSDKAssets" target="app/src/main/assets/XheyCameraSDKAssets" />

    <!-- Ensure a dedicated plugin values file exists for safer merging on projects without a strings.xml -->
    <resource-file src="src/android/res/values/xhey_plugin.xml" target="app/src/main/res/values/xhey_plugin.xml" />
    <!-- Removed inline <config-file> that wrote app/src/main/res/values/xhey_plugin.xml; use preferences/resource-file instead -->

    <config-file target="app/src/main/AndroidManifest.xml" parent="/manifest">
      <uses-permission android:name="android.permission.CAMERA" />
      <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
      <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    </config-file>

    <!-- Register native plugin class so Cordova can map JS exec to Java implementation -->
    <config-file target="config.xml" parent="/*">
      <feature name="XheyCamera">
        <param name="android-package" value="org.xhey.cordova.camera.XheyCamera" />
      </feature>
    </config-file>

    <!-- Use the modern cordova-android path; keep a single entry to avoid duplicate-copy errors. -->
    <source-file src="src/android/XheyCamera.java" target-dir="app/src/main/java/org/xhey/cordova/camera" />
  </platform>

  <platform name="ios">
    <!-- iOS: place Xhey SDK framework/xcframework under src/ios/libs if available -->
    <!-- Example: <framework src="src/ios/libs/XheyCameraSDK.xcframework" type="podspec" /> -->

    <!-- Note: plugin reads credentials from Cordova preferences (`APPID` / `SECRET_KEY`).
         Previously this wrote keys into Info.plist; that automatic injection was removed
         to prefer explicit preferences in the host app's `config.xml`. If you need
         Info.plist entries, add `xhey_appid` / `xhey_secret_key` to your app's Info.plist manually. -->

    <!-- iOS source files -->
    <source-file src="src/ios/XheyCamera.m" />
    <source-file src="src/ios/XheyCamera.h" />

    <!-- request camera/location permissions via plist entries if needed -->
    <config-file target="*-Info.plist" parent="NSCameraUsageDescription">
      <string>需要使用相机进行拍照</string>
    </config-file>
    <config-file target="*-Info.plist" parent="NSLocationWhenInUseUsageDescription">
      <string>需要定位以用于水印中的位置信息</string>
    </config-file>
  </platform>

  <engines>
    <engine name="cordova" version=">=9.0.0" />
  </engines>
</plugin>
