<?xml version="1.0" encoding="utf-8"?>
<plugin id="cordova-plugin-xhey-camera" version="0.0.1" xmlns="http://apache.org/cordova/ns/plugins/1.0" xmlns:android="http://schemas.android.com/apk/res/android">
  <name>XheyCamera</name>
  <description>Cordova plugin wrapper for Xhey (今日水印) Camera SDK</description>
  <license>MIT</license>
  <preference name="APPID" />
  <preference name="SECRET_KEY" />

  <js-module src="www/xhey-camera.js" name="XheyCamera">
    <clobbers target="XheyCamera" />
  </js-module>

  <platform name="android">
    <!-- Gradle build extras for AAR dependency management -->
    <framework src="src/android/libs/build-extras.gradle" custom="true" type="gradleReference" />
    
    <!-- Hook removed: build-extras.gradle already provides AAR repositories/dependencies -->
    
    <!-- Add the AAR SDK library as a lib-file for Gradle inclusion -->
    <!-- Cordova will copy this to platforms/android/app/libs/ -->
    <lib-file src="src/android/libs/xheycamerasdk-release.aar" />
    
    <!-- Copy SDK web assets into app www assets (recursively). -->
    <asset src="src/android/assets/XheyCameraSDKAssets" target="XheyCameraSDKAssets" />

   
    <config-file target="app/src/main/AndroidManifest.xml" parent="/manifest">
      <uses-permission android:name="android.permission.CAMERA" />
      <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
      <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
      <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
      <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
      <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    </config-file>

    <!-- Ensure the SDK Activity is declared in the merged AndroidManifest so explicit
         intents targeting its class can be resolved regardless of host package name. -->
    <config-file target="app/src/main/AndroidManifest.xml" parent="/manifest/application">
      <activity android:name="com.xhey.xheycamerasdk.CameraActivity" android:exported="false" />
      <activity android:name="org.xhey.cordova.camera.CustomCameraActivity" android:exported="false" />
      <meta-data android:name="APPID" android:value="$APPID" />
      <meta-data android:name="SECRET_KEY" android:value="$SECRET_KEY" />
    </config-file>

    <!-- Register native plugin class so Cordova can map JS exec to Java implementation -->
    <config-file target="config.xml" parent="/*">
      <feature name="XheyCamera">
        <param name="android-package" value="org.xhey.cordova.camera.XheyCamera" />
      </feature>
    </config-file>

    <!-- Use the modern cordova-android path; keep a single entry to avoid duplicate-copy errors. -->
    <source-file src="src/android/XheyCamera.java" target-dir="app/src/main/java/org/xhey/cordova/camera" />
    <source-file src="src/android/CustomCameraActivity.java" target-dir="app/src/main/java/org/xhey/cordova/camera" />
  </platform>

  <platform name="ios">
    <!-- iOS: place Xhey SDK framework/xcframework under src/ios/libs if available -->
    <!-- Example: <framework src="src/ios/libs/XheyCameraSDK.xcframework" type="podspec" /> -->

    <!-- Note: plugin reads credentials from Cordova preferences (`APPID` / `SECRET_KEY`).
         Previously this wrote keys into Info.plist; that automatic injection was removed
         to prefer explicit preferences in the host app's `config.xml`. If you need
         Info.plist entries, add `xhey_appid` / `xhey_secret_key` to your app's Info.plist manually. -->

    <!-- iOS source files -->
    <source-file src="src/ios/XheyCamera.m" />
    <source-file src="src/ios/XheyCamera.h" />

        <!-- Link XheyCamera SDK xcframework and resource bundle if present in repo -->
        <!-- Place your XCFramework and resource bundle under `src/ios/libs/` with these names:
          `XheyCameraSDK.xcframework` and `XheyCameraSDKResource.bundle`.
          If you keep a different folder/name, adjust these paths accordingly. -->
        <framework src="src/ios/libs/XheyCameraSDK-v1.2.327.9c500eba.iOS.dynamic/XheyCameraSDK.xcframework" custom="true" />
        <resource-file src="src/ios/libs/XheyCameraSDK-v1.2.327.9c500eba.iOS.dynamic/XheyCameraSDKResource.bundle" />

    <!-- request camera/location permissions via plist entries if needed -->
    <config-file target="*-Info.plist" parent="NSCameraUsageDescription">
      <string>需要使用相机进行拍照</string>
    </config-file>
    <config-file target="*-Info.plist" parent="NSLocationWhenInUseUsageDescription">
      <string>需要定位以用于水印中的位置信息</string> 
    </config-file>
    <config-file target="*-Info.plist" parent="NSPhotoLibraryAddUsageDescription">
      <string>用于将拍摄的照片保存到相册</string>
    </config-file>
    <config-file target="*-Info.plist" parent="NSPhotoLibraryUsageDescription">
      <string>需要访问相册以保存或读取图片</string>
    </config-file>
  </platform>

  <!-- Register iOS plugin class so Cordova maps JS exec to Objective-C implementation -->
  <config-file target="config.xml" parent="/*">
    <feature name="XheyCamera">
      <param name="ios-package" value="XheyCamera" />
    </feature>
  </config-file>

  <engines>
    <engine name="cordova" version=">=9.0.0" />
  </engines>
</plugin>
